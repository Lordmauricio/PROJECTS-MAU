// Prisma schema - Restaurante SaaS Bolivia
// Multi-tenant: cada restaurante es una Company, con una o mas Branch (sucursales).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Tenant / Empresa ----------

model Company {
  id        String   @id @default(cuid())
  name      String // Nombre comercial
  razonSocial String // Razon social (como figura en el NIT)
  nit       String   @unique
  email     String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches    Branch[]
  users       User[]
  categories  Category[]
  products    Product[]
  customers   Customer[]
  orders      Order[]
  invoices    Invoice[]
}

model Branch {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name      String // ej. "Sucursal Sopocachi"
  address   String?
  municipio String?
  departamento String?
  phone     String?
  isMatriz  Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users        User[]
  orders       Order[]
  invoices     Invoice[]
  fiscalConfig FiscalConfig?

  @@index([companyId])
}

// ---------- Usuarios ----------

enum Role {
  OWNER
  ADMIN
  CASHIER
  KITCHEN
}

model User {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId  String?
  branch    Branch?  @relation(fields: [branchId], references: [id])

  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(CASHIER)
  active       Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ordersCreated Order[] @relation("OrderCreatedBy")

  @@index([companyId])
}

// ---------- Menu ----------

model Category {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name      String
  sortOrder Int      @default(0)
  active    Boolean  @default(true)

  products Product[]

  @@index([companyId])
}

model Product {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  name        String
  description String?
  price       Decimal  @db.Decimal(10, 2)
  imageUrl    String?
  sku         String?
  active      Boolean  @default(true)

  // Campos utiles para facturacion (unidad de medida SIN, codigo de actividad economica)
  unitCode     String @default("58") // 58 = Unidad (codigo generico SIN)
  activityCode String? // Codigo de actividad economica CAEB si aplica a nivel producto

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderItems OrderItem[]

  @@index([companyId])
  @@index([categoryId])
}

// ---------- Clientes ----------

enum DocumentType {
  NIT
  CI
  CEX
  PASAPORTE
  OTRO
  SIN_NOMBRE // "Sin Nombre" / consumidor final, NIT 99001
}

model Customer {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name           String
  documentType   DocumentType @default(SIN_NOMBRE)
  documentNumber String       @default("99001")
  complement     String?
  email          String?
  phone          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders   Order[]
  invoices Invoice[]

  @@index([companyId])
}

// ---------- Pedidos (POS) ----------

enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
}

enum OrderStatus {
  OPEN
  IN_PREPARATION
  READY
  DELIVERED
  PAID
  CANCELLED
}

model Order {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId   String
  branch     Branch   @relation(fields: [branchId], references: [id])
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  type        OrderType   @default(TAKEAWAY)
  status      OrderStatus @default(OPEN)
  tableNumber String?

  subtotal Decimal @db.Decimal(10, 2) @default(0)
  discount Decimal @db.Decimal(10, 2) @default(0)
  total    Decimal @db.Decimal(10, 2) @default(0)

  createdById String?
  createdBy   User?   @relation("OrderCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items    OrderItem[]
  payments Payment[]
  invoice  Invoice?

  @@index([companyId])
  @@index([branchId])
  @@index([status])
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId   String
  product     Product @relation(fields: [productId], references: [id])
  productName String // snapshot del nombre al momento de la venta
  unitPrice   Decimal @db.Decimal(10, 2)
  quantity    Int
  notes       String?
  subtotal    Decimal @db.Decimal(10, 2)

  @@index([orderId])
}

// ---------- Pagos ----------

enum PaymentMethod {
  CASH
  CARD
  QR_SIMPLE
  OTHER
}

model Payment {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  method         PaymentMethod
  amount         Decimal       @db.Decimal(10, 2)
  receivedAmount Decimal?      @db.Decimal(10, 2)
  changeAmount   Decimal?      @db.Decimal(10, 2)

  createdAt DateTime @default(now())

  @@index([orderId])
}

// ---------- Facturacion electronica (SIN Bolivia) ----------

enum FiscalEnvironment {
  TEST // Ambiente "Piloto" del SIN
  PRODUCTION
}

// Configuracion fiscal por sucursal / punto de venta.
// Estos datos los asigna el SIN cuando la empresa se registra como
// facturador electronico (Oficina Virtual > Facturacion > Registro de Sucursales/Puntos de Venta).
model FiscalConfig {
  id       String @id @default(cuid())
  branchId String @unique
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  environment FiscalEnvironment @default(TEST)

  nit            String // NIT del emisor
  razonSocial    String
  codigoSucursal Int    @default(0) // 0 = Casa Matriz
  codigoPuntoVenta Int  @default(0)
  codigoAmbiente Int    @default(2) // 1 = Produccion, 2 = Piloto/Pruebas (segun especificacion SIN)
  codigoModalidad Int   @default(2) // 2 = Electronica en linea
  codigoSistema  String? // Codigo de sistema informatico asignado por el SIN al homologar

  // CUIS: Codigo Unico de Inicio de Sistemas. Se solicita una vez por
  // punto de venta y es valido hasta que se revoque.
  cuis           String?
  cuisFechaVigencia DateTime?

  // Llave/certificado de firma digital (se completa cuando el SIN entrega
  // el certificado de produccion). En ambiente simulado queda vacio.
  signingKeyRef String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cufdCache CufdCache[]
}

// Cache del CUFD (Codigo Unico de Facturacion Diaria), valido por 24h.
model CufdCache {
  id             String       @id @default(cuid())
  fiscalConfigId String
  fiscalConfig   FiscalConfig @relation(fields: [fiscalConfigId], references: [id], onDelete: Cascade)

  cufd            String
  codigoControl   String
  fechaVigencia   DateTime // hasta cuando es valido
  createdAt       DateTime @default(now())

  @@index([fiscalConfigId])
}

enum InvoiceState {
  VALIDA
  ANULADA
  OBSERVADA
}

model Invoice {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId   String
  branch     Branch   @relation(fields: [branchId], references: [id])
  orderId    String   @unique
  order      Order    @relation(fields: [orderId], references: [id])
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  numeroFactura Int
  cuf           String @unique
  cufd          String
  cuis          String

  xml           String @db.Text
  qrData        String @db.Text
  qrImagePng    String? @db.Text // data URL base64 del QR generado

  montoTotal Decimal      @db.Decimal(10, 2)
  state      InvoiceState @default(VALIDA)
  leyenda    String       @default("Ley N° 453: El proveedor del servicio de facturacion se encuentra impedido de revelar tus datos a terceros...")

  environment FiscalEnvironment @default(TEST)

  fechaEmision DateTime @default(now())
  motivoAnulacion String?
  anuladaAt DateTime?

  @@index([companyId])
  @@index([branchId])
}

// Correlativo de numero de factura por sucursal (numeracion continua exigida por el SIN).
model InvoiceSequence {
  id       String @id @default(cuid())
  branchId String @unique
  lastNumber Int  @default(0)
}
