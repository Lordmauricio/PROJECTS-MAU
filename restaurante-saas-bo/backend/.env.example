# Base de datos
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/restaurante_saas?schema=public"

# Servidor
PORT=4000
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_EXPIRES_IN="12h"

# Modulo de facturacion electronica (SIN Bolivia)
# SIN_PROVIDER = "mock" mientras no se tienen credenciales reales del SIN.
# Cuando el SIN homologe el sistema y entregue credenciales de Piloto/Produccion,
# cambiar a "soap" y completar las variables SIN_WSDL_* correspondientes.
SIN_PROVIDER="mock"
SIN_WSDL_BASE_URL="https://pilotosiat.impuestos.gob.bo"
SIN_API_KEY=""
