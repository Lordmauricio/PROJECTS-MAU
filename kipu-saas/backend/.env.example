# ATENCIÓN: este archivo es una PLANTILLA versionada en el repositorio.
# Nunca escribas acá una contraseña real — ni siquiera "de desarrollo": todo
# lo que esté en este archivo es público. Copialo a `.env` (que está en
# .gitignore) y completá los valores ahí.
# Para generar un secreto: openssl rand -base64 32

# Conexión de administración (usada por `prisma migrate` y por
# `npm run db:provision-roles`). En local puede ser el superusuario; en
# producción, un rol con permiso de DDL.
DATABASE_URL="postgresql://postgres:REEMPLAZAR@localhost:5432/kipu_saas?schema=public"

# Conexión que usa la aplicación NestJS en runtime. DEBE ser un rol SIN
# BYPASSRLS (ver migración inicial: rol `app_user`). Si esto apunta al mismo
# superusuario que DATABASE_URL, el aislamiento de tenant (RLS) deja de
# aplicarse silenciosamente — `PrismaService` falla al arrancar si detecta
# que el rol tiene BYPASSRLS.
# La contraseña debe coincidir con APP_USER_PASSWORD (ver abajo).
RUNTIME_DATABASE_URL="postgresql://app_user:REEMPLAZAR@localhost:5432/kipu_saas?schema=public"

# Contraseña del rol Postgres `app_user`. Las migraciones crean el rol SIN
# contraseña a propósito (una migración versionada nunca debe contener una
# credencial); se la asigna este comando, que es también el mecanismo de
# rotación:
#     npm run db:provision-roles
APP_USER_PASSWORD=""

# Opcional. Solo si se define, `db:provision-roles` habilita el rol
# `app_superadmin` (LOGIN + contraseña). Ese rol tiene BYPASSRLS y ve los
# datos de TODOS los tenants: dejalo vacío mientras ningún módulo lo use
# (queda NOLOGIN, que es lo correcto hoy).
APP_SUPERADMIN_PASSWORD=""

# Secretos de firma. Tienen que ser DISTINTOS entre sí y, en producción, de
# al menos 32 caracteres — el arranque valida ambas cosas y no levanta si no
# se cumplen (ver src/config/env.validation.ts).
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

REDIS_URL="redis://localhost:6379"

PORT=4200

# "production" activa el modo estricto: exige CORS_ORIGINS, secretos largos y
# EMAIL_PROVIDER=smtp, y deja de devolver el detalle de los errores al cliente.
NODE_ENV="development"

# Orígenes del frontend habilitados para llamar a esta API, separados por
# coma (ej. "https://app.kipu.bo,https://admin.kipu.bo"). Vacío o "none" =
# ningún navegador puede consumirla. En producción es obligatorio y no se
# acepta "*".
CORS_ORIGINS="http://localhost:3000"

# Poner en "true" SOLO si hay un reverse proxy delante (nginx, ALB, Cloud
# Run) que fija X-Forwarded-For. Sin proxy, activarlo permitiría a cualquiera
# falsear su IP y esquivar el rate limiting.
TRUST_PROXY="false"

# URL pública del frontend — usada para armar links en emails (reset de
# contraseña, verificación de correo). No es un secreto.
FRONTEND_URL="http://localhost:3000"

# Proveedor de email real (Fase Comercial 9). "console" (default) solo
# escribe el email en el log sin enviarlo — sirve para desarrollo/CI sin
# credenciales, y por eso el arranque lo RECHAZA en producción: ahí hay que
# usar "smtp", que envía vía nodemailer y exige HOST/PORT/FROM.
EMAIL_PROVIDER="console"
EMAIL_FROM="no-reply@kipu-saas.local"
EMAIL_SMTP_HOST=""
EMAIL_SMTP_PORT="587"
EMAIL_SMTP_USER=""
EMAIL_SMTP_PASSWORD=""
