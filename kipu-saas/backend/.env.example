# Conexión de administración (usada por `prisma migrate`). En local puede
# ser el superusuario; en producción, un rol con permiso de DDL.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kipu_saas?schema=public"

# Conexión que usa la aplicación NestJS en runtime. DEBE ser un rol SIN
# BYPASSRLS (ver migración inicial: rol `app_user`). Si esto apunta al mismo
# superusuario que DATABASE_URL, el aislamiento de tenant (RLS) deja de
# aplicarse silenciosamente.
RUNTIME_DATABASE_URL="postgresql://app_user:app_user_dev_password@localhost:5432/kipu_saas?schema=public"

JWT_ACCESS_SECRET="change-me-long-random-secret"
JWT_REFRESH_SECRET="change-me-different-long-random-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

REDIS_URL="redis://localhost:6379"

PORT=4200

# URL pública del frontend — usada para armar links en emails (reset de
# contraseña, verificación de correo). No es un secreto.
FRONTEND_URL="http://localhost:3000"

# Proveedor de email real (Fase Comercial 9). "console" (default) solo
# loguea el email sin enviarlo — seguro para desarrollo/CI sin credenciales.
# "smtp" envía de verdad vía nodemailer usando las credenciales de abajo.
EMAIL_PROVIDER="console"
EMAIL_FROM="no-reply@kipu-saas.local"
EMAIL_SMTP_HOST=""
EMAIL_SMTP_PORT="587"
EMAIL_SMTP_USER=""
EMAIL_SMTP_PASSWORD=""
