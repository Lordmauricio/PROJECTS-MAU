// KIPU SAAS — schema Fase 1 (Foundation)
//
// Estrategia de tenancy: base de datos compartida, aislamiento por
// organizationId + PostgreSQL Row Level Security (RLS). Ver
// docs/architecture.md. Las policies de RLS NO se declaran aquí (Prisma no
// las modela) sino en una migración SQL manual
// (prisma/migrations/*_init/migration.sql).
//
// Convención: toda tabla propiedad de una empresa tiene `organizationId`
// como columna directa (incluso si también se llega a ella por relación),
// para que la policy de RLS sea una comparación simple sin JOIN.
//
// Alcance de Fase 1 (Foundation): todas las entidades del dominio están
// modeladas acá (tal como pide el prompt: "diseñar correctamente el modelo
// antes de implementar funcionalidades"), pero solo un subconjunto tiene
// módulos NestJS con endpoints reales en esta fase — el resto (ventas,
// compras, caja, facturación, suscripciones, notificaciones, archivos)
// queda con su tabla lista y sin lógica de negocio todavía, para no
// construir pantallas o endpoints a medias. Ver docs/PROJECT_PLAN.md.

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ==========================================================
// Tenant raíz
// ==========================================================

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  CANCELLED
}

model Organization {
  id               String             @id @default(cuid())
  name             String // nombre comercial
  legalName        String // razón social
  nit              String             @unique
  economicActivity String?
  address          String?
  phone            String?
  email            String?
  logoUrl          String?
  currency         String             @default("BOB")
  timezone         String             @default("America/La_Paz")
  status           OrganizationStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships       OrganizationUser[]
  roles             Role[]
  branches          Branch[]
  customers         Customer[]
  suppliers         Supplier[]
  productCategories ProductCategory[]
  productUnits      ProductUnit[]
  products          Product[]
  auditLogs         AuditLog[]
  subscription      Subscription?

  @@map("organizations")
}

// ==========================================================
// Identidad global (un usuario puede pertenecer a varias organizaciones)
// ==========================================================

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String
  name            String
  emailVerifiedAt DateTime?
  active          Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships             OrganizationUser[]
  refreshTokens           RefreshToken[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]

  @@map("users")
}

model RefreshToken {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Contexto de organización/rol con el que se emitió este refresh token.
  // Nullable porque tokens emitidos antes de este campo no lo tienen.
  // Se usa en el refresh para preservar la organización activa de la
  // sesión en vez de re-elegir una arbitrariamente entre las membresías
  // del usuario (bug corregido en la auditoría de Fase 1).
  organizationId String?
  roleId         String?

  tokenHash String    @unique
  userAgent String?
  ip        String?
  expiresAt DateTime
  revokedAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model EmailVerificationToken {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

// ==========================================================
// Membresía / RBAC (tenant-scoped: RLS aplica)
// ==========================================================

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

model OrganizationUser {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId         String
  role           Role         @relation(fields: [roleId], references: [id])

  status    MembershipStatus @default(INVITED)
  invitedAt DateTime         @default(now())
  joinedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("organization_users")
}

// Catálogo de permisos: tabla global (no tenant-scoped).
model Permission {
  id          String @id @default(cuid())
  key         String @unique
  module      String
  description String

  rolePermissions RolePermission[]

  @@map("permissions")
}

// Roles por organización: OWNER/ADMIN/MANAGER/ACCOUNTANT/CASHIER/INVENTORY/
// SALES/AUDITOR se clonan al crear la empresa; se permite además crear
// roles custom (isSystem = false) a futuro.
model Role {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  key         String
  name        String
  isSystem    Boolean @default(true)
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships     OrganizationUser[]
  rolePermissions RolePermission[]

  @@unique([organizationId, key])
  @@index([organizationId])
  @@map("roles")
}

model RolePermission {
  id             String     @id @default(cuid())
  organizationId String // denormalizado para que la policy de RLS no necesite JOIN
  roleId         String
  role           Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId   String
  permission     Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([roleId, permissionId])
  @@index([organizationId])
  @@map("role_permissions")
}

// ==========================================================
// Sucursales / Almacenes / Puntos de venta
// Empresa -> Sucursal -> Almacén
//                     -> Punto de Venta
// ==========================================================

model Branch {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name         String
  address      String?
  municipality String?
  department   String?
  phone        String?
  isMainOffice Boolean @default(false)
  active       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  warehouses       Warehouse[]
  posTerminals     POSTerminal[]
  taxConfiguration TaxConfiguration?

  @@index([organizationId])
  @@map("branches")
}

model Warehouse {
  id             String @id @default(cuid())
  organizationId String
  branchId       String
  branch         Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  name    String
  address String?
  active  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventories        Inventory[]
  inventoryMovements InventoryMovement[]
  sales              Sale[]
  purchases          Purchase[]
  transfersOut       InventoryTransfer[] @relation("InventoryTransferFrom")
  transfersIn        InventoryTransfer[] @relation("InventoryTransferTo")

  @@index([organizationId])
  @@index([branchId])
  @@map("warehouses")
}

model POSTerminal {
  id             String @id @default(cuid())
  organizationId String
  branchId       String
  branch         Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  name   String
  code   String
  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cashRegisters CashRegister[]
  sales         Sale[]

  @@unique([branchId, code])
  @@index([organizationId])
  @@index([branchId])
  @@map("pos_terminals")
}

// ==========================================================
// Clientes / Proveedores
// ==========================================================

enum PartyDocumentType {
  NIT
  CI
  CEX
  PASAPORTE
  OTRO
  SIN_NOMBRE
}

model Customer {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name           String
  businessName   String?
  documentType   PartyDocumentType @default(SIN_NOMBRE)
  documentNumber String            @default("99001")
  phone          String?
  email          String?
  address        String?
  active         Boolean           @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sales       Sale[]
  invoices    Invoice[]
  receivables Receivable[]

  @@index([organizationId])
  @@map("customers")
}

model Supplier {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name         String
  businessName String?
  nit          String?
  phone        String?
  email        String?
  address      String?
  active       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products  Product[]
  purchases Purchase[]
  payables  Payable[]

  @@unique([organizationId, nit])
  @@index([organizationId])
  @@map("suppliers")
}

// ==========================================================
// Productos / Inventario
// ==========================================================

model ProductCategory {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name      String
  sortOrder Int     @default(0)
  active    Boolean @default(true)

  products Product[]

  @@index([organizationId])
  @@map("product_categories")
}

model ProductUnit {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name   String // ej. "Unidad", "Caja", "Kilogramo"
  symbol String // ej. "u", "caja", "kg"
  active Boolean @default(true)

  products Product[]

  @@index([organizationId])
  @@map("product_units")
}

model Product {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  categoryId     String?
  category       ProductCategory? @relation(fields: [categoryId], references: [id])
  unitId         String?
  unit           ProductUnit?     @relation(fields: [unitId], references: [id])
  supplierId     String?
  supplier       Supplier?        @relation(fields: [supplierId], references: [id])

  code           String?
  sku            String?
  barcode        String?
  name           String
  description    String?
  brand          String?
  cost           Decimal  @default(0) @db.Decimal(12, 2)
  price          Decimal  @db.Decimal(12, 2)
  wholesalePrice Decimal? @db.Decimal(12, 2)
  minStock       Decimal  @default(0) @db.Decimal(12, 2)
  imageUrl       String?
  active         Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventories        Inventory[]
  inventoryMovements InventoryMovement[]
  inventoryTransfers InventoryTransfer[]
  saleItems          SaleItem[]
  purchaseItems      PurchaseItem[]
  invoiceItems       InvoiceItem[]

  @@unique([organizationId, sku])
  @@unique([organizationId, barcode])
  @@index([organizationId])
  @@index([categoryId])
  @@map("products")
}

model Inventory {
  id             String    @id @default(cuid())
  organizationId String
  warehouseId    String
  warehouse      Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  productId      String
  product        Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  quantity Decimal @default(0) @db.Decimal(12, 2)

  updatedAt DateTime @updatedAt

  @@unique([warehouseId, productId])
  @@index([organizationId])
  @@map("inventories")
}

enum InventoryMovementType {
  IN
  OUT
  TRANSFER
  ADJUSTMENT
  RETURN
}

model InventoryMovement {
  id             String    @id @default(cuid())
  organizationId String
  warehouseId    String
  warehouse      Warehouse @relation(fields: [warehouseId], references: [id])
  productId      String
  product        Product   @relation(fields: [productId], references: [id])

  type        InventoryMovementType
  quantity    Decimal               @db.Decimal(12, 2)
  // Snapshot del stock de este producto en ESTE almacén inmediatamente
  // antes/después de aplicar el movimiento — persistido en el momento
  // (Fase Comercial 4), no recalculado después, para que el kardex pueda
  // mostrar el saldo corriente sin tener que reproducir todo el historial.
  stockBefore Decimal               @db.Decimal(12, 2)
  stockAfter  Decimal               @db.Decimal(12, 2)
  reason      String?
  reference   String? // p.ej. id de venta/compra/transferencia relacionada
  userId      String?

  // Solo la usan movimientos que se registran directamente por esta vía
  // (entrada/salida/ajuste manual, cada leg de una transferencia) — los
  // movimientos que dispara Ventas/Compras no la necesitan porque ya están
  // protegidos por la idempotencia de su propia operación padre (confirmar
  // venta, recibir compra). Única globalmente, mismo criterio que
  // Payment.idempotencyKey.
  idempotencyKey String? @unique

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([warehouseId])
  @@index([productId])
  @@index([createdAt])
  @@map("inventory_movements")
}

// Cabecera de una transferencia entre almacenes de la misma organización.
// Cada transferencia genera exactamente 2 InventoryMovement (tipo
// TRANSFER: uno OUT en el almacén origen, uno IN en el destino) dentro de
// la MISMA transacción — ambos comparten `reference` = este id, así se
// reconstruye el par origen/destino sin necesitar columnas redundantes en
// InventoryMovement.
model InventoryTransfer {
  id             String @id @default(cuid())
  organizationId String

  productId       String
  product         Product   @relation(fields: [productId], references: [id])
  fromWarehouseId String
  fromWarehouse   Warehouse @relation("InventoryTransferFrom", fields: [fromWarehouseId], references: [id])
  toWarehouseId   String
  toWarehouse     Warehouse @relation("InventoryTransferTo", fields: [toWarehouseId], references: [id])

  quantity Decimal @db.Decimal(12, 2)
  reason   String?

  idempotencyKey String?  @unique
  createdById    String?
  createdAt      DateTime @default(now())

  @@index([organizationId])
  @@index([fromWarehouseId])
  @@index([toWarehouseId])
  @@index([productId])
  @@map("inventory_transfers")
}

// ==========================================================
// Ventas / Compras / Pagos / Caja
// (tablas listas desde Foundation; sin módulo de negocio en esta fase)
// ==========================================================

enum SaleType {
  SALE
  QUOTE
}

enum SaleStatus {
  DRAFT
  CONFIRMED
  PARTIALLY_PAID
  PAID
  CANCELLED
  REFUNDED
}

model Sale {
  id             String       @id @default(cuid())
  organizationId String
  posTerminalId  String?
  posTerminal    POSTerminal? @relation(fields: [posTerminalId], references: [id])
  // Almacén del que se descuenta stock al confirmar. Requerido en la
  // práctica para SaleType.SALE (validado en el service, no acá, para no
  // romper el modelado de QUOTE que no afecta inventario); nulo solo
  // mientras la venta está en DRAFT sin almacén elegido todavía.
  warehouseId    String?
  warehouse      Warehouse?   @relation(fields: [warehouseId], references: [id])
  customerId     String?
  customer       Customer?    @relation(fields: [customerId], references: [id])

  type     SaleType   @default(SALE)
  status   SaleStatus @default(DRAFT)
  subtotal Decimal    @default(0) @db.Decimal(12, 2)
  discount Decimal    @default(0) @db.Decimal(12, 2)
  total    Decimal    @default(0) @db.Decimal(12, 2)

  createdById String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  confirmedAt DateTime?
  cancelledAt DateTime?
  refundedAt  DateTime?

  items             SaleItem[]
  payments          Payment[]
  invoice           Invoice?
  receivable        Receivable?
  refunds           Refund[]
  commercialReceipt CommercialReceipt?

  @@index([organizationId])
  @@index([warehouseId])
  @@map("sales")
}

model SaleItem {
  id             String  @id @default(cuid())
  organizationId String // denormalizado desde Sale para que la policy de RLS no necesite JOIN
  saleId         String
  sale           Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId      String
  product        Product @relation(fields: [productId], references: [id])

  quantity  Decimal @db.Decimal(12, 2)
  unitPrice Decimal @db.Decimal(12, 2)
  discount  Decimal @default(0) @db.Decimal(12, 2)
  subtotal  Decimal @db.Decimal(12, 2)

  @@index([organizationId])
  @@index([saleId])
  @@map("sale_items")
}

enum PurchaseStatus {
  DRAFT
  CONFIRMED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

model Purchase {
  id             String     @id @default(cuid())
  organizationId String
  supplierId     String
  supplier       Supplier   @relation(fields: [supplierId], references: [id])
  // Almacén donde entra el stock al recibir. Mismo criterio que Sale.warehouseId
  // (Fase Comercial 2): requerido en la práctica desde que se confirma la
  // orden, validado en el service, nulo solo mientras está en DRAFT.
  warehouseId    String?
  warehouse      Warehouse? @relation(fields: [warehouseId], references: [id])

  status   PurchaseStatus @default(DRAFT)
  subtotal Decimal        @default(0) @db.Decimal(12, 2)
  discount Decimal        @default(0) @db.Decimal(12, 2)
  total    Decimal        @default(0) @db.Decimal(12, 2)

  createdById String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  confirmedAt DateTime?
  cancelledAt DateTime?
  // Se fija cuando el status pasa a RECEIVED (recepción completa), no en
  // cada recepción parcial — ver PurchaseReceipt para el historial de cada
  // evento de recepción individual.
  receivedAt  DateTime?

  items    PurchaseItem[]
  payables Payable[]
  receipts PurchaseReceipt[]
  returns  PurchaseReturn[]

  @@index([organizationId])
  @@index([warehouseId])
  @@map("purchases")
}

model PurchaseItem {
  id             String   @id @default(cuid())
  organizationId String // denormalizado desde Purchase para que la policy de RLS no necesite JOIN
  purchaseId     String
  purchase       Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId      String
  product        Product  @relation(fields: [productId], references: [id])

  quantity         Decimal @db.Decimal(12, 2) // cantidad ordenada
  // Acumulados a través de todas las PurchaseReceiptItem / devoluciones de
  // este ítem — permiten validar "no recibir más de lo pedido" y "no
  // devolver más de lo recibido" sin tener que sumar el historial cada vez.
  receivedQuantity Decimal @default(0) @db.Decimal(12, 2)
  returnedQuantity Decimal @default(0) @db.Decimal(12, 2)
  unitCost         Decimal @db.Decimal(12, 2)
  discount         Decimal @default(0) @db.Decimal(12, 2)
  subtotal         Decimal @db.Decimal(12, 2)

  receiptItems PurchaseReceiptItem[]
  returnItems  PurchaseReturnItem[]

  @@index([organizationId])
  @@index([purchaseId])
  @@map("purchase_items")
}

// Ledger de eventos de recepción — el análogo, para Compras, de `Payment`
// en Ventas (Fase Comercial 2): cada recepción (total o parcial) queda
// como una fila propia, con su propia idempotencyKey, en vez de mutar
// directamente PurchaseItem.receivedQuantity sin dejar rastro de cuándo/
// cómo se llegó a ese número.
model PurchaseReceipt {
  id             String   @id @default(cuid())
  organizationId String
  purchaseId     String
  purchase       Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  // Generada por el cliente una vez por intento de recepción y reutilizada
  // en cualquier reintento/doble click — misma protección que
  // Payment.idempotencyKey.
  idempotencyKey String? @unique
  notes          String?
  receivedById   String?

  createdAt DateTime @default(now())

  items PurchaseReceiptItem[]

  @@index([organizationId])
  @@index([purchaseId])
  @@map("purchase_receipts")
}

model PurchaseReceiptItem {
  id                String          @id @default(cuid())
  organizationId    String // denormalizado, mismo criterio que el resto de los *Item
  purchaseReceiptId String
  purchaseReceipt   PurchaseReceipt @relation(fields: [purchaseReceiptId], references: [id], onDelete: Cascade)
  purchaseItemId    String
  purchaseItem      PurchaseItem    @relation(fields: [purchaseItemId], references: [id])

  quantity Decimal @db.Decimal(12, 2)

  @@index([organizationId])
  @@index([purchaseReceiptId])
  @@map("purchase_receipt_items")
}

// Ledger de devoluciones al proveedor — mismo patrón que PurchaseReceipt
// (idempotencyKey propia, trazabilidad propia). Nunca borra ni reescribe
// PurchaseItem/PurchaseReceipt; solo incrementa PurchaseItem.returnedQuantity.
model PurchaseReturn {
  id             String   @id @default(cuid())
  organizationId String
  purchaseId     String
  purchase       Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  idempotencyKey String? @unique
  reason         String?
  createdById    String?

  createdAt DateTime @default(now())

  items PurchaseReturnItem[]

  @@index([organizationId])
  @@index([purchaseId])
  @@map("purchase_returns")
}

model PurchaseReturnItem {
  id               String         @id @default(cuid())
  organizationId   String
  purchaseReturnId String
  purchaseReturn   PurchaseReturn @relation(fields: [purchaseReturnId], references: [id], onDelete: Cascade)
  purchaseItemId   String
  purchaseItem     PurchaseItem   @relation(fields: [purchaseItemId], references: [id])

  quantity Decimal @db.Decimal(12, 2)

  @@index([organizationId])
  @@index([purchaseReturnId])
  @@map("purchase_return_items")
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  QR
  MIXED
}

// Ledger genérico de pagos: dinero que ENTRA (contra una Sale, del
// cliente) o dinero que SALE (contra un Payable, hacia un proveedor).
// Justo una de las dos relaciones debe estar presente — se refuerza con un
// CHECK constraint agregado a mano en la migración (Prisma no modela
// CHECK entre columnas todavía).
model Payment {
  id             String   @id @default(cuid())
  organizationId String
  saleId         String?
  sale           Sale?    @relation(fields: [saleId], references: [id])
  payableId      String?
  payable        Payable? @relation(fields: [payableId], references: [id])

  method String  @default("CASH")
  amount Decimal @db.Decimal(12, 2)

  // Provista por el cliente (uuid generado una vez por intento de cobro y
  // reutilizada en cualquier reintento/doble click). Única globalmente:
  // permite detectar y responder de forma idempotente a un mismo intento de
  // pago repetido, sin volver a aplicarlo contra el saldo de la venta o
  // cuenta por pagar.
  idempotencyKey String? @unique

  createdById String?
  createdAt   DateTime @default(now())

  @@index([organizationId])
  @@index([saleId])
  @@index([payableId])
  @@map("payments")
}

enum CashRegisterStatus {
  OPEN
  CLOSED
}

model CashRegister {
  id             String      @id @default(cuid())
  organizationId String
  posTerminalId  String
  posTerminal    POSTerminal @relation(fields: [posTerminalId], references: [id])

  status             CashRegisterStatus @default(OPEN)
  openingAmount      Decimal            @default(0) @db.Decimal(12, 2)
  // Arqueo de cierre (Fase Comercial 5): `closingAmount` es el efectivo
  // CONTADO físicamente por el usuario al cerrar; `expectedAmount` es el
  // saldo que el sistema esperaba (openingAmount + ingresos - egresos, ver
  // `CashService.close`); `difference` = contado - esperado (positivo =
  // sobrante, negativo = faltante). Los tres quedan null mientras la caja
  // sigue OPEN.
  closingAmount      Decimal?           @db.Decimal(12, 2)
  expectedAmount     Decimal?           @db.Decimal(12, 2)
  difference         Decimal?           @db.Decimal(12, 2)
  closingObservation String?

  openedById String?
  closedById String?
  openedAt   DateTime  @default(now())
  closedAt   DateTime?

  // Únicas por separado (no una sola columna) porque abrir y cerrar son dos
  // operaciones distintas con su propia protección de doble
  // click/retry — mismo patrón que `Payment.idempotencyKey`. La
  // apertura además se apoya en un índice único parcial agregado a mano en
  // la migración (`WHERE status = 'OPEN'`, Prisma no expresa índices
  // parciales en su DSL) para impedir dos cajas OPEN del mismo
  // `posTerminalId` incluso bajo concurrencia real — ver
  // `docs/architecture.md`.
  openingIdempotencyKey String? @unique
  closingIdempotencyKey String? @unique

  movements CashMovement[]
  expenses  Expense[]

  @@index([organizationId])
  @@index([posTerminalId])
  @@map("cash_registers")
}

model CashMovement {
  id             String       @id @default(cuid())
  organizationId String
  cashRegisterId String
  cashRegister   CashRegister @relation(fields: [cashRegisterId], references: [id], onDelete: Cascade)

  type      String // CASH_IN, CASH_OUT, SALE_PAYMENT, EXPENSE
  amount    Decimal @db.Decimal(12, 2)
  reason    String?
  // Id de la entidad que originó el movimiento cuando no fue manual (la
  // Sale de un SALE_PAYMENT, el Expense de un EXPENSE) — mismo patrón que
  // `InventoryMovement.reference`.
  reference String?

  createdById    String?
  // Nullable: los movimientos SALE_PAYMENT (disparados automáticamente al
  // cobrar en efectivo, ver `CashService.registerSalePaymentMovement`) no
  // pasan por el DTO de movimiento manual y no necesitan una key propia —
  // ya heredan la idempotencia de `Payment.idempotencyKey` (la venta nunca
  // vuelve a ejecutar ese código dos veces para el mismo pago, ver
  // `docs/architecture.md`). Los movimientos manuales (CASH_IN/CASH_OUT) y
  // los EXPENSE sí la exigen.
  idempotencyKey String? @unique

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([cashRegisterId])
  @@map("cash_movements")
}

// ==========================================================
// Gastos / Cuentas por cobrar / Cuentas por pagar
// ==========================================================

model Expense {
  id             String       @id @default(cuid())
  organizationId String
  cashRegisterId String
  cashRegister   CashRegister @relation(fields: [cashRegisterId], references: [id])

  category    String?
  amount      Decimal  @db.Decimal(12, 2)
  description String?
  observation String?
  date        DateTime @default(now())

  createdById    String?
  // Protege contra doble click/retry: un gasto y su CashMovement se crean
  // atómicamente en la misma transacción (ver `CashService.registerExpense`).
  idempotencyKey String? @unique

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([cashRegisterId])
  @@map("expenses")
}

enum ReceivablePayableStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

model Receivable {
  id             String   @id @default(cuid())
  organizationId String
  customerId     String
  customer       Customer @relation(fields: [customerId], references: [id])
  // Una Receivable nace SIEMPRE de una venta a crédito (Fase Comercial 6) —
  // @unique porque a lo sumo puede haber una por venta ("No crear
  // Receivable duplicado para una misma venta"). Nullable por consistencia
  // con `Payable.purchaseId` (NULLs no colisionan entre sí en Postgres), no
  // porque hoy exista un camino que la deje sin venta asociada.
  saleId         String?  @unique
  sale           Sale?    @relation(fields: [saleId], references: [id])

  amount  Decimal                 @db.Decimal(12, 2)
  dueDate DateTime
  status  ReceivablePayableStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([customerId])
  @@map("receivables")
}

// Reembolso de una venta devuelta (Fase Comercial 6): registra CUÁNTO se le
// debe devolver al cliente (lo efectivamente pagado hasta la devolución),
// separado del `Payment` original — mismo principio de ledger que
// `PurchaseReturn` respecto de `PurchaseReceipt`. No lleva `idempotencyKey`
// propia: `SalesService.returnSale()` ya es idempotente por lock +
// chequeo de estado (mismo patrón que `cancel()`), así que esta fila se
// crea a lo sumo una vez por venta.
model Refund {
  id             String @id @default(cuid())
  organizationId String
  saleId         String
  sale           Sale   @relation(fields: [saleId], references: [id])

  amount Decimal @db.Decimal(12, 2)
  reason String?

  createdById String?
  createdAt   DateTime @default(now())

  @@index([organizationId])
  @@index([saleId])
  @@map("refunds")
}

model Payable {
  id             String    @id @default(cuid())
  organizationId String
  supplierId     String
  supplier       Supplier  @relation(fields: [supplierId], references: [id])
  // Una compra tiene a lo sumo una Payable — crece con cada recepción
  // (nunca se crea una Payable antes de que llegue mercadería real) y se
  // reduce con las devoluciones al proveedor. @@unique sobre una columna
  // nullable es seguro en Postgres: NULLs no colisionan entre sí, solo se
  // exige unicidad cuando purchaseId SÍ está seteado.
  purchaseId     String?   @unique
  purchase       Purchase? @relation(fields: [purchaseId], references: [id])

  amount  Decimal                 @db.Decimal(12, 2)
  dueDate DateTime
  status  ReceivablePayableStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments Payment[]

  @@index([organizationId])
  @@index([supplierId])
  @@map("payables")
}

// ==========================================================
// Recibos comerciales (Fase Comercial 8) — NO FISCALES
// `CommercialReceipt` es un documento comercial interno, completamente
// independiente de `Invoice`/`FiscalDocument` (sección "Facturación /
// Fiscal" más abajo). No genera XML, no calcula CUF/CUFD/CAFC, no firma
// nada, no reemplaza la factura exigida por la normativa tributaria — ver
// `docs/architecture.md` sección 14 y `docs/PROJECT_PLAN.md`. Una venta
// podrá eventualmente tener AMBOS documentos a la vez (`Sale` →
// `CommercialReceipt` y, en una fase futura independiente, `Sale` →
// `Invoice`/`FiscalDocument`), sin que uno dependa del otro.
// ==========================================================

// Contador atómico de numeración de recibos, uno por organización. El
// incremento SIEMPRE pasa por un solo `UPDATE ... RETURNING` (ver
// `ReceiptsService.nextReceiptNumber`) — nunca `MAX(number) + 1`, que bajo
// concurrencia real puede leer el mismo máximo dos veces y emitir el mismo
// número. `series` es un valor fijo por organización (hoy siempre "REC"),
// guardado en la fila en vez de hardcodeado en el código para poder
// diferenciarlo a futuro sin migrar datos existentes.
model ReceiptSequence {
  id             String @id @default(cuid())
  organizationId String @unique
  series         String @default("REC")
  lastNumber     Int    @default(0)

  updatedAt DateTime @updatedAt

  @@map("receipt_sequences")
}

// Snapshot inmutable de una venta al momento de emitir su recibo
// comercial. Relación 1:1 estricta con `Sale` (`@@unique([saleId])`): una
// venta nunca puede tener dos recibos — ver la idempotencia de
// `ReceiptsService.issue`. `snapshot` (JSONB) es la ÚNICA fuente para
// regenerar el PDF: si después cambian el nombre/dirección/logo de la
// empresa, los datos del cliente, o el precio de un producto, el recibo ya
// emitido nunca cambia, porque el PDF nunca vuelve a leer esas tablas —
// lee el JSON congelado acá. `series`/`number` quedan también como
// columnas propias (no solo dentro del JSON) para poder indexar/exponer la
// numeración sin parsear JSON.
model CommercialReceipt {
  id             String @id @default(cuid())
  organizationId String
  saleId         String @unique
  sale           Sale   @relation(fields: [saleId], references: [id])

  series String
  number Int

  // Snapshot inmutable completo: emisor, sucursal/POS, cliente, ítems,
  // pagos, totales, cajero — ver `ReceiptsService.buildSnapshot` para la
  // forma exacta. Nunca se reescribe después de creado.
  snapshot Json

  issuedById String?
  issuedAt   DateTime @default(now())

  @@unique([organizationId, series, number])
  @@index([organizationId])
  @@map("commercial_receipts")
}

// ==========================================================
// Facturación / Fiscal
// Solo esquema en esta fase. La integración real con el SIN es Parte 2 /
// Fase 5 (ver docs/PROJECT_PLAN.md) — no se inventan campos ni algoritmos
// fiscales acá.
// ==========================================================

enum InvoiceStatus {
  VALID
  CANCELLED
  ERROR
}

model Invoice {
  id             String    @id @default(cuid())
  organizationId String
  saleId         String    @unique
  sale           Sale      @relation(fields: [saleId], references: [id])
  customerId     String?
  customer       Customer? @relation(fields: [customerId], references: [id])

  number String?
  status InvoiceStatus @default(VALID)
  total  Decimal       @db.Decimal(12, 2)

  issuedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items  InvoiceItem[]
  events InvoiceEvent[]

  @@index([organizationId])
  @@map("invoices")
}

model InvoiceItem {
  id             String   @id @default(cuid())
  organizationId String // denormalizado desde Invoice para que la policy de RLS no necesite JOIN
  invoiceId      String
  invoice        Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId      String?
  product        Product? @relation(fields: [productId], references: [id])

  description String
  quantity    Decimal @db.Decimal(12, 2)
  unitPrice   Decimal @db.Decimal(12, 2)
  subtotal    Decimal @db.Decimal(12, 2)

  @@index([organizationId])
  @@index([invoiceId])
  @@map("invoice_items")
}

model InvoiceEvent {
  id             String  @id @default(cuid())
  organizationId String
  invoiceId      String
  invoice        Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  type    String // ISSUED, CANCELLED, ERROR, RESENT
  payload String? @db.Text

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([invoiceId])
  @@map("invoice_events")
}

// Configuración tributaria por sucursal — placeholders sin lógica SIN real.
model TaxConfiguration {
  id             String @id @default(cuid())
  organizationId String
  branchId       String @unique
  branch         Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  nit            String?
  regime         String?
  environment    String    @default("TEST")
  branchCode     Int?
  posCode        Int?
  systemCode     String?
  cuis           String?
  cuisValidUntil DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@map("tax_configurations")
}

// ==========================================================
// Suscripción del tenant al SaaS (planes de KIPU, no facturación del tenant)
// ==========================================================

model Plan {
  id           String  @id @default(cuid())
  key          String  @unique // free, basic, pro, enterprise
  name         String
  priceMonthly Decimal @default(0) @db.Decimal(12, 2)
  limits       Json // { maxUsers, maxBranches, maxProducts, ... }
  features     Json // { pos: true, inventory: true, ... }
  active       Boolean @default(true)

  subscriptions Subscription[]

  @@map("plans")
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
}

model Subscription {
  id             String       @id @default(cuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  planId         String
  plan           Plan         @relation(fields: [planId], references: [id])

  status           SubscriptionStatus @default(TRIALING)
  currentPeriodEnd DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events SubscriptionEvent[]

  @@index([organizationId])
  @@map("subscriptions")
}

model SubscriptionEvent {
  id             String       @id @default(cuid())
  organizationId String
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  type    String
  payload String? @db.Text

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([subscriptionId])
  @@map("subscription_events")
}

// ==========================================================
// Notificaciones / Archivos
// ==========================================================

model Notification {
  id             String  @id @default(cuid())
  organizationId String
  userId         String?

  type    String
  title   String
  message String
  read    Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([userId])
  @@map("notifications")
}

model File {
  id             String  @id @default(cuid())
  organizationId String
  ownerId        String?

  filename   String
  storageKey String
  mimeType   String
  size       Int

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@map("files")
}

// ==========================================================
// Auditoría
// ==========================================================

model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String?

  action     String // ej. "auth.login", "organization.create", "role.permissions.update"
  entityType String?
  entityId   String?
  metadata   Json?
  ip         String?
  userAgent  String?

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([action])
  @@map("audit_logs")
}
