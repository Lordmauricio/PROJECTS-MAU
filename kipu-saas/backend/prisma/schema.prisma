// KIPU SAAS — schema Fase 1 (Foundation)
//
// Estrategia de tenancy: base de datos compartida, aislamiento por
// organizationId + PostgreSQL Row Level Security (RLS). Ver
// docs/architecture.md. Las policies de RLS NO se declaran aquí (Prisma no
// las modela) sino en una migración SQL manual
// (prisma/migrations/*_init/migration.sql).
//
// Convención: toda tabla propiedad de una empresa tiene `organizationId`
// como columna directa (incluso si también se llega a ella por relación),
// para que la policy de RLS sea una comparación simple sin JOIN.
//
// Alcance de Fase 1 (Foundation): todas las entidades del dominio están
// modeladas acá (tal como pide el prompt: "diseñar correctamente el modelo
// antes de implementar funcionalidades"), pero solo un subconjunto tiene
// módulos NestJS con endpoints reales en esta fase — el resto (ventas,
// compras, caja, facturación, suscripciones, notificaciones, archivos)
// queda con su tabla lista y sin lógica de negocio todavía, para no
// construir pantallas o endpoints a medias. Ver docs/PROJECT_PLAN.md.

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ==========================================================
// Tenant raíz
// ==========================================================

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  CANCELLED
}

model Organization {
  id               String             @id @default(cuid())
  name             String // nombre comercial
  legalName        String // razón social
  nit              String             @unique
  economicActivity String?
  address          String?
  phone            String?
  email            String?
  logoUrl          String?
  currency         String             @default("BOB")
  timezone         String             @default("America/La_Paz")
  status           OrganizationStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships       OrganizationUser[]
  roles             Role[]
  branches          Branch[]
  customers         Customer[]
  suppliers         Supplier[]
  productCategories ProductCategory[]
  productUnits      ProductUnit[]
  products          Product[]
  auditLogs         AuditLog[]
  subscription      Subscription?

  @@map("organizations")
}

// ==========================================================
// Identidad global (un usuario puede pertenecer a varias organizaciones)
// ==========================================================

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String
  name            String
  emailVerifiedAt DateTime?
  active          Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships             OrganizationUser[]
  refreshTokens           RefreshToken[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]

  @@map("users")
}

model RefreshToken {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Contexto de organización/rol con el que se emitió este refresh token.
  // Nullable porque tokens emitidos antes de este campo no lo tienen.
  // Se usa en el refresh para preservar la organización activa de la
  // sesión en vez de re-elegir una arbitrariamente entre las membresías
  // del usuario (bug corregido en la auditoría de Fase 1).
  organizationId String?
  roleId         String?

  tokenHash String    @unique
  userAgent String?
  ip        String?
  expiresAt DateTime
  revokedAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model EmailVerificationToken {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

// ==========================================================
// Membresía / RBAC (tenant-scoped: RLS aplica)
// ==========================================================

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

model OrganizationUser {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId         String
  role           Role         @relation(fields: [roleId], references: [id])

  status    MembershipStatus @default(INVITED)
  invitedAt DateTime         @default(now())
  joinedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("organization_users")
}

// Catálogo de permisos: tabla global (no tenant-scoped).
model Permission {
  id          String @id @default(cuid())
  key         String @unique
  module      String
  description String

  rolePermissions RolePermission[]

  @@map("permissions")
}

// Roles por organización: OWNER/ADMIN/MANAGER/ACCOUNTANT/CASHIER/INVENTORY/
// SALES/AUDITOR se clonan al crear la empresa; se permite además crear
// roles custom (isSystem = false) a futuro.
model Role {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  key         String
  name        String
  isSystem    Boolean @default(true)
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships     OrganizationUser[]
  rolePermissions RolePermission[]

  @@unique([organizationId, key])
  @@index([organizationId])
  @@map("roles")
}

model RolePermission {
  id             String     @id @default(cuid())
  organizationId String // denormalizado para que la policy de RLS no necesite JOIN
  roleId         String
  role           Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId   String
  permission     Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([roleId, permissionId])
  @@index([organizationId])
  @@map("role_permissions")
}

// ==========================================================
// Sucursales / Almacenes / Puntos de venta
// Empresa -> Sucursal -> Almacén
//                     -> Punto de Venta
// ==========================================================

model Branch {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name         String
  address      String?
  municipality String?
  department   String?
  phone        String?
  isMainOffice Boolean @default(false)
  active       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  warehouses       Warehouse[]
  posTerminals     POSTerminal[]
  taxConfiguration TaxConfiguration?

  @@index([organizationId])
  @@map("branches")
}

model Warehouse {
  id             String @id @default(cuid())
  organizationId String
  branchId       String
  branch         Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  name    String
  address String?
  active  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventories        Inventory[]
  inventoryMovements InventoryMovement[]

  @@index([organizationId])
  @@index([branchId])
  @@map("warehouses")
}

model POSTerminal {
  id             String @id @default(cuid())
  organizationId String
  branchId       String
  branch         Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  name   String
  code   String
  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cashRegisters CashRegister[]
  sales         Sale[]

  @@unique([branchId, code])
  @@index([organizationId])
  @@index([branchId])
  @@map("pos_terminals")
}

// ==========================================================
// Clientes / Proveedores
// ==========================================================

enum PartyDocumentType {
  NIT
  CI
  CEX
  PASAPORTE
  OTRO
  SIN_NOMBRE
}

model Customer {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name           String
  businessName   String?
  documentType   PartyDocumentType @default(SIN_NOMBRE)
  documentNumber String            @default("99001")
  phone          String?
  email          String?
  address        String?
  active         Boolean           @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sales       Sale[]
  invoices    Invoice[]
  receivables Receivable[]

  @@index([organizationId])
  @@map("customers")
}

model Supplier {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name         String
  businessName String?
  nit          String?
  phone        String?
  email        String?
  address      String?
  active       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products  Product[]
  purchases Purchase[]
  payables  Payable[]

  @@unique([organizationId, nit])
  @@index([organizationId])
  @@map("suppliers")
}

// ==========================================================
// Productos / Inventario
// ==========================================================

model ProductCategory {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name      String
  sortOrder Int     @default(0)
  active    Boolean @default(true)

  products Product[]

  @@index([organizationId])
  @@map("product_categories")
}

model ProductUnit {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name   String // ej. "Unidad", "Caja", "Kilogramo"
  symbol String // ej. "u", "caja", "kg"
  active Boolean @default(true)

  products Product[]

  @@index([organizationId])
  @@map("product_units")
}

model Product {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  categoryId     String?
  category       ProductCategory? @relation(fields: [categoryId], references: [id])
  unitId         String?
  unit           ProductUnit?     @relation(fields: [unitId], references: [id])
  supplierId     String?
  supplier       Supplier?        @relation(fields: [supplierId], references: [id])

  code           String?
  sku            String?
  barcode        String?
  name           String
  description    String?
  brand          String?
  cost           Decimal  @default(0) @db.Decimal(12, 2)
  price          Decimal  @db.Decimal(12, 2)
  wholesalePrice Decimal? @db.Decimal(12, 2)
  minStock       Decimal  @default(0) @db.Decimal(12, 2)
  imageUrl       String?
  active         Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventories        Inventory[]
  inventoryMovements InventoryMovement[]
  saleItems          SaleItem[]
  purchaseItems      PurchaseItem[]
  invoiceItems       InvoiceItem[]

  @@unique([organizationId, sku])
  @@unique([organizationId, barcode])
  @@index([organizationId])
  @@index([categoryId])
  @@map("products")
}

model Inventory {
  id             String    @id @default(cuid())
  organizationId String
  warehouseId    String
  warehouse      Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  productId      String
  product        Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  quantity Decimal @default(0) @db.Decimal(12, 2)

  updatedAt DateTime @updatedAt

  @@unique([warehouseId, productId])
  @@index([organizationId])
  @@map("inventories")
}

enum InventoryMovementType {
  IN
  OUT
  TRANSFER
  ADJUSTMENT
  RETURN
}

model InventoryMovement {
  id             String    @id @default(cuid())
  organizationId String
  warehouseId    String
  warehouse      Warehouse @relation(fields: [warehouseId], references: [id])
  productId      String
  product        Product   @relation(fields: [productId], references: [id])

  type      InventoryMovementType
  quantity  Decimal               @db.Decimal(12, 2)
  reason    String?
  reference String? // p.ej. id de venta/compra relacionada
  userId    String?

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([warehouseId])
  @@index([productId])
  @@map("inventory_movements")
}

// ==========================================================
// Ventas / Compras / Pagos / Caja
// (tablas listas desde Foundation; sin módulo de negocio en esta fase)
// ==========================================================

enum SaleType {
  SALE
  QUOTE
}

enum SaleStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

model Sale {
  id             String       @id @default(cuid())
  organizationId String
  posTerminalId  String?
  posTerminal    POSTerminal? @relation(fields: [posTerminalId], references: [id])
  customerId     String?
  customer       Customer?    @relation(fields: [customerId], references: [id])

  type     SaleType   @default(SALE)
  status   SaleStatus @default(DRAFT)
  subtotal Decimal    @default(0) @db.Decimal(12, 2)
  discount Decimal    @default(0) @db.Decimal(12, 2)
  total    Decimal    @default(0) @db.Decimal(12, 2)

  createdById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items    SaleItem[]
  payments Payment[]
  invoice  Invoice?

  @@index([organizationId])
  @@map("sales")
}

model SaleItem {
  id             String  @id @default(cuid())
  organizationId String // denormalizado desde Sale para que la policy de RLS no necesite JOIN
  saleId         String
  sale           Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId      String
  product        Product @relation(fields: [productId], references: [id])

  quantity  Decimal @db.Decimal(12, 2)
  unitPrice Decimal @db.Decimal(12, 2)
  discount  Decimal @default(0) @db.Decimal(12, 2)
  subtotal  Decimal @db.Decimal(12, 2)

  @@index([organizationId])
  @@index([saleId])
  @@map("sale_items")
}

enum PurchaseStatus {
  DRAFT
  RECEIVED
  CANCELLED
}

model Purchase {
  id             String   @id @default(cuid())
  organizationId String
  supplierId     String
  supplier       Supplier @relation(fields: [supplierId], references: [id])

  status   PurchaseStatus @default(DRAFT)
  subtotal Decimal        @default(0) @db.Decimal(12, 2)
  total    Decimal        @default(0) @db.Decimal(12, 2)

  createdById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items    PurchaseItem[]
  payables Payable[]

  @@index([organizationId])
  @@map("purchases")
}

model PurchaseItem {
  id             String   @id @default(cuid())
  organizationId String // denormalizado desde Purchase para que la policy de RLS no necesite JOIN
  purchaseId     String
  purchase       Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId      String
  product        Product  @relation(fields: [productId], references: [id])

  quantity Decimal @db.Decimal(12, 2)
  unitCost Decimal @db.Decimal(12, 2)
  subtotal Decimal @db.Decimal(12, 2)

  @@index([organizationId])
  @@index([purchaseId])
  @@map("purchase_items")
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  QR
  MIXED
}

model Payment {
  id             String  @id @default(cuid())
  organizationId String
  saleId         String?
  sale           Sale?   @relation(fields: [saleId], references: [id])

  method String  @default("CASH")
  amount Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([saleId])
  @@map("payments")
}

enum CashRegisterStatus {
  OPEN
  CLOSED
}

model CashRegister {
  id             String      @id @default(cuid())
  organizationId String
  posTerminalId  String
  posTerminal    POSTerminal @relation(fields: [posTerminalId], references: [id])

  status        CashRegisterStatus @default(OPEN)
  openingAmount Decimal            @default(0) @db.Decimal(12, 2)
  closingAmount Decimal?           @db.Decimal(12, 2)
  openedById    String?
  closedById    String?
  openedAt      DateTime           @default(now())
  closedAt      DateTime?

  movements CashMovement[]

  @@index([organizationId])
  @@index([posTerminalId])
  @@map("cash_registers")
}

model CashMovement {
  id             String       @id @default(cuid())
  organizationId String
  cashRegisterId String
  cashRegister   CashRegister @relation(fields: [cashRegisterId], references: [id], onDelete: Cascade)

  type   String // CASH_IN, CASH_OUT, SALE_PAYMENT, EXPENSE
  amount Decimal @db.Decimal(12, 2)
  reason String?

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([cashRegisterId])
  @@map("cash_movements")
}

// ==========================================================
// Gastos / Cuentas por cobrar / Cuentas por pagar
// ==========================================================

model Expense {
  id             String @id @default(cuid())
  organizationId String

  category    String
  amount      Decimal  @db.Decimal(12, 2)
  description String?
  date        DateTime @default(now())

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@map("expenses")
}

enum ReceivablePayableStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

model Receivable {
  id             String   @id @default(cuid())
  organizationId String
  customerId     String
  customer       Customer @relation(fields: [customerId], references: [id])

  amount  Decimal                 @db.Decimal(12, 2)
  dueDate DateTime
  status  ReceivablePayableStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([customerId])
  @@map("receivables")
}

model Payable {
  id             String    @id @default(cuid())
  organizationId String
  supplierId     String
  supplier       Supplier  @relation(fields: [supplierId], references: [id])
  purchaseId     String?
  purchase       Purchase? @relation(fields: [purchaseId], references: [id])

  amount  Decimal                 @db.Decimal(12, 2)
  dueDate DateTime
  status  ReceivablePayableStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([supplierId])
  @@map("payables")
}

// ==========================================================
// Facturación / Fiscal
// Solo esquema en esta fase. La integración real con el SIN es Parte 2 /
// Fase 5 (ver docs/PROJECT_PLAN.md) — no se inventan campos ni algoritmos
// fiscales acá.
// ==========================================================

enum InvoiceStatus {
  VALID
  CANCELLED
  ERROR
}

model Invoice {
  id             String    @id @default(cuid())
  organizationId String
  saleId         String    @unique
  sale           Sale      @relation(fields: [saleId], references: [id])
  customerId     String?
  customer       Customer? @relation(fields: [customerId], references: [id])

  number String?
  status InvoiceStatus @default(VALID)
  total  Decimal       @db.Decimal(12, 2)

  issuedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items  InvoiceItem[]
  events InvoiceEvent[]

  @@index([organizationId])
  @@map("invoices")
}

model InvoiceItem {
  id             String   @id @default(cuid())
  organizationId String // denormalizado desde Invoice para que la policy de RLS no necesite JOIN
  invoiceId      String
  invoice        Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId      String?
  product        Product? @relation(fields: [productId], references: [id])

  description String
  quantity    Decimal @db.Decimal(12, 2)
  unitPrice   Decimal @db.Decimal(12, 2)
  subtotal    Decimal @db.Decimal(12, 2)

  @@index([organizationId])
  @@index([invoiceId])
  @@map("invoice_items")
}

model InvoiceEvent {
  id             String  @id @default(cuid())
  organizationId String
  invoiceId      String
  invoice        Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  type    String // ISSUED, CANCELLED, ERROR, RESENT
  payload String? @db.Text

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([invoiceId])
  @@map("invoice_events")
}

// Configuración tributaria por sucursal — placeholders sin lógica SIN real.
model TaxConfiguration {
  id             String @id @default(cuid())
  organizationId String
  branchId       String @unique
  branch         Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  nit            String?
  regime         String?
  environment    String    @default("TEST")
  branchCode     Int?
  posCode        Int?
  systemCode     String?
  cuis           String?
  cuisValidUntil DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@map("tax_configurations")
}

// ==========================================================
// Suscripción del tenant al SaaS (planes de KIPU, no facturación del tenant)
// ==========================================================

model Plan {
  id           String  @id @default(cuid())
  key          String  @unique // free, basic, pro, enterprise
  name         String
  priceMonthly Decimal @default(0) @db.Decimal(12, 2)
  limits       Json // { maxUsers, maxBranches, maxProducts, ... }
  features     Json // { pos: true, inventory: true, ... }
  active       Boolean @default(true)

  subscriptions Subscription[]

  @@map("plans")
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
}

model Subscription {
  id             String       @id @default(cuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  planId         String
  plan           Plan         @relation(fields: [planId], references: [id])

  status           SubscriptionStatus @default(TRIALING)
  currentPeriodEnd DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events SubscriptionEvent[]

  @@index([organizationId])
  @@map("subscriptions")
}

model SubscriptionEvent {
  id             String       @id @default(cuid())
  organizationId String
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  type    String
  payload String? @db.Text

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([subscriptionId])
  @@map("subscription_events")
}

// ==========================================================
// Notificaciones / Archivos
// ==========================================================

model Notification {
  id             String  @id @default(cuid())
  organizationId String
  userId         String?

  type    String
  title   String
  message String
  read    Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([userId])
  @@map("notifications")
}

model File {
  id             String  @id @default(cuid())
  organizationId String
  ownerId        String?

  filename   String
  storageKey String
  mimeType   String
  size       Int

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@map("files")
}

// ==========================================================
// Auditoría
// ==========================================================

model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String?

  action     String // ej. "auth.login", "organization.create", "role.permissions.update"
  entityType String?
  entityId   String?
  metadata   Json?
  ip         String?
  userAgent  String?

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([action])
  @@map("audit_logs")
}
